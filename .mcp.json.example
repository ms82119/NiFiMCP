{
  "mcpServers": {
    "nifi": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/NiFiMCP",
        "python",
        "-m",
        "nifi_mcp_server.stdio_server"
      ],
      "env": {
        "NIFI_SERVER_ID": "nifi-dev"
      }
    },
    "nifi-prod": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/NiFiMCP",
        "python",
        "-m",
        "nifi_mcp_server.stdio_server"
      ],
      "env": {
        "NIFI_SERVER_ID": "nifi-prod"
      }
    }
  }
}
